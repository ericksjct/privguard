{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./data_sensivel/**)",
      "Read(./cooperados/**)",
      "Read(./dump_*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.cooperados.csv)",
      "Read(./**/*.cpf.txt)",
      "Read(./**/credenciais*)",
      "Read(./**/segredo*)",
      "Bash(type ./data_sensivel/**)",
      "Bash(type ./cooperados/**)",
      "Bash(cat ./data_sensivel/**)",
      "Bash(cat ./cooperados/**)",
      "Bash(Get-Content ./data_sensivel/**)",
      "Bash(Get-Content ./cooperados/**)",
      "Bash(Select-String ./data_sensivel/**)",
      "Bash(findstr * ./data_sensivel/**)",
      "Glob(./data_sensivel/**)",
      "Grep(./data_sensivel/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/hooks/pii_guard.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/hooks/pre_tool_guard.py\""
          }
        ]
      }
    ]
  }
}
